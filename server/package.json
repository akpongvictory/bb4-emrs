{
  "name": "bb4-emrs-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/app.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/app.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit && tsc -p prisma/tsconfig.json",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
